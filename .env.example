# Local defaults. Leave EV_TRAIN_CSV blank to auto-discover Downloads/archive/ev_market_train.csv.
# Copy to .env to override these settings. Never commit a populated .env file or credentials.
EV_TRAIN_CSV=
EV_TABLE_NAME=ev_market_train

# Required project workflow: the local SQLite database is created and populated from the training CSV on first launch.
DATABASE_URL=sqlite:///ev_market.sqlite

# Public Tableau views used by the Flask page. These links are public and contain no credentials.
TABLEAU_PUBLIC_URL=https://public.tableau.com/app/profile/man.mohan.singh3746/viz/EV_Market_Performance_Rating_Corrected/Dashboard1
TABLEAU_STORY_URL=https://public.tableau.com/app/profile/man.mohan.singh3746/viz/EV_Market_Performance_Rating_Corrected/Story2

FLASK_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Website accounts use this Flask session secret. Set a private random value when hosting.
SECRET_KEY=
SESSION_COOKIE_SECURE=false
REQUIRE_SECRET_KEY=false
TRUST_PROXY=false
