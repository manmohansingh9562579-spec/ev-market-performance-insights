# Local defaults. Leave EV_TRAIN_CSV blank to auto-discover Downloads/archive/ev_market_train.csv.
# Copy to .env to override these settings. Never commit a populated .env file or credentials.
EV_TRAIN_CSV=
EV_TABLE_NAME=ev_market_train

# Local default: SQLite is created and populated from the training CSV on first launch.
# To use MySQL instead, clear DATABASE_URL and configure the DB_* values below.
DATABASE_URL=sqlite:///ev_market.sqlite

# Option B: MySQL connection settings. Leave these blank for CSV/SQLite use.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Public Tableau views used by the local Flask page. These links are public and contain no credentials.
TABLEAU_PUBLIC_URL=https://public.tableau.com/app/profile/man.mohan.singh3746/viz/EV_Market_Performance_Green_Executive_Refresh/Dashboard1
TABLEAU_STORY_URL=https://public.tableau.com/app/profile/man.mohan.singh3746/viz/EV_Market_Performance_Green_Executive_Refresh/Story2

FLASK_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Website accounts use this Flask session secret. Set a private random value when self-hosting.
SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Optional MySQL CA certificate path for verified TLS, for example on Render.
MYSQL_SSL_CA=
