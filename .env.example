# Copy to .env and set values for your machine. Never commit a populated .env file.
EV_TRAIN_CSV=C:/path/to/ev_market_train.csv
EV_TABLE_NAME=ev_market_train

# Option A: provide a SQLAlchemy URL directly.
DATABASE_URL=

# Option B: MySQL connection settings. Leave these blank for CSV/SQLite use.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional: enter the published Tableau Public links to enable the official dashboard and Story embeds.
TABLEAU_PUBLIC_URL=
TABLEAU_STORY_URL=

FLASK_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO
